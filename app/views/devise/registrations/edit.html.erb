<h2>Edit <%= resource_name.to_s.humanize %></h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

<div class="mb-4 flex flex-col gap-1">
    <%= f.label :email, class: "font-semibold text-gray-700" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
    <div>Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
  <% end %>

  <div class="mb-4 flex flex-col gap-1">
    <%= f.label :password, class: "font-semibold text-gray-700" %> <i class="text-sm text-gray-500">(leave blank if you don't want to change it)</i>
    <%= f.password_field :password, autocomplete: "new-password", class: "border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    <% if @minimum_password_length %>
      <em class="text-xs text-gray-500"><%= @minimum_password_length %> characters minimum</em>
    <% end %>
  </div>

  <div class="mb-4 flex flex-col gap-1">
    <%= f.label :password_confirmation, class: "font-semibold text-gray-700" %>
    <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="mb-4 flex flex-col gap-1">
    <%= f.label :current_password, class: "font-semibold text-gray-700" %> <i class="text-sm text-gray-500">(we need your current password to confirm your changes)</i>
    <%= f.password_field :current_password, autocomplete: "current-password", class: "border rounded px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
  </div>

  <div class="mt-6 flex justify-end">
    <%= f.submit "Update", class: "bg-blue-600 text-white font-semibold px-4 py-2 rounded hover:bg-blue-700 transition" %>
  </div>
<% end %>

<h3>Cancel my account</h3>

<div>Unhappy? <%= button_to "Cancel my account", registration_path(resource_name), data: { confirm: "Are you sure?", turbo_confirm: "Are you sure?" }, method: :delete %></div>

<%= link_to "Back", :back %>
