<h2>Forgot your password?</h2>
<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
<div class="mb-4 flex flex-col">
    <%= f.label :email, class: "mb-2 text-sm font-medium text-gray-700" %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "rounded-md border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 w-full" %>
  </div>

  <div class="mt-6 flex justify-end">
    <%= f.submit "Send me reset password instructions", class: "px-4 py-2 bg-indigo-600 text-white rounded hover:bg-indigo-700 transition" %>
  </div>
<% end %>
<%= render "devise/shared/links" %>
